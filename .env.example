# Pulse Fitness Tracker Environment Configuration

# Application Port & Mode
VITE_APP_PORT=3003
VITE_APP_ENV=development

# Wearable Sync Gateway (Apple Health / Garmin / Strava)
VITE_WEARABLE_SYNC_API_URL=https://sync.pulse.flegartech.com/v1

# Preferred Units
VITE_DEFAULT_WEIGHT_UNIT=kg
VITE_DEFAULT_DISTANCE_UNIT=km

# Default User Biometrics
VITE_DEFAULT_RESTING_HEART_RATE=60
VITE_DEFAULT_MAX_HEART_RATE=190
